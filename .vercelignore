# Files Vercel must not upload with the function bundle.
# (The same list keeps the Python bundle far below the 500 MB limit.)

# Secrets — never upload
.env
.env.*

# Local virtualenvs and caches
.venv
venv
env
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov

# Local-only data: the 15 MB source PDF is only needed by `python ingest.py`,
# which runs offline. The deployed app reads from Pinecone.
data

# Development-only files
tests
requirements-dev.txt
.github
.vscode
.idea
Dockerfile
docker-compose.yml
.dockerignore

# Docs
*.md
LICENSE
