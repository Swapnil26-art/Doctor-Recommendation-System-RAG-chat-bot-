# Copy this file to `.env` and fill in your own keys.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# NEVER commit `.env`. It is listed in .gitignore.

# Google AI Studio -> https://aistudio.google.com/apikey
# Used for the RAG chatbot (Gemini).
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"

# Google Cloud Console -> enable "Places API"
# Used for the nearby doctor / hospital search.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_PLACES_API_KEY"

# Pinecone -> https://app.pinecone.io
# The index must be an *integrated* index using llama-text-embed-v2
# (name: medicalbot, dimension: 384, metric: cosine).
PINECONE_API_KEY="YOUR_PINECONE_API_KEY"

# --- Optional overrides (defaults shown) ---
# PINECONE_INDEX="medicalbot"
# PINECONE_NAMESPACE="knowledge-base"
# RETRIEVAL_TOP_K="4"
# MIN_RELEVANCE_SCORE="0.30"
# LLM_MODEL="gemini-3.8-flash"   # or "gemini-flash-latest"
# CHUNK_SIZE="1000"
# CHUNK_OVERLAP="150"
# PLACES_RADIUS_KM="50"
# PLACES_MAX_RESULTS="5"
# LOG_LEVEL="INFO"
# PORT="8080"
# HOST="127.0.0.1"
