# Copy this file to `.env` and fill in your own keys.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# NEVER commit `.env`. It is listed in .gitignore.

# Google AI Studio -> https://aistudio.google.com/apikey
# Used for the RAG chatbot (Gemini).
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"

# Google Cloud Console -> enable "Places API"
# Used for the nearby doctor / hospital search.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_PLACES_API_KEY"

# Pinecone -> https://app.pinecone.io
# Used for the vector knowledge base (index name: medicalbot, 384 dimensions).
PINECONE_API_KEY="YOUR_PINECONE_API_KEY"

# --- Optional overrides (defaults shown) ---
# PINECONE_INDEX="medicalbot"
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# LLM_MODEL="gemini-2.5-flash"
# PLACES_RADIUS_KM="50"
# PLACES_MAX_RESULTS="5"
# LOG_LEVEL="INFO"
# PORT="8080"
# HOST="127.0.0.1"
